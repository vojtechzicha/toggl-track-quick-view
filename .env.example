# Optional: set your Toggl Track API token here to run a private, single-user
# instance. When this is set, the app detects it on load, connects
# automatically, and HIDES the token field in Settings entirely (you only pick
# a project). Find it at https://track.toggl.com/profile (bottom of the page).
#
# If you leave this unset, just paste your token into the app's Settings panel;
# it is stored only in your browser's localStorage.
TOGGL_API_TOKEN=

# Optional: password-protect the dashboard. Only takes effect together with
# TOGGL_API_TOKEN above (in server-managed mode there is a shared token whose
# data is worth protecting; with per-browser tokens there is nothing to gate).
#
# When set, visitors must enter this password before any data is shown, and the
# server-side Toggl proxy refuses to serve data without a valid session. The
# password itself is never stored anywhere; the browser keeps only a signed,
# 7-day session token, so a device asks for the password at most once a week.
# Changing this value immediately invalidates all existing sessions.
#
# Use a long, random value, and only over HTTPS (Vercel deployments are HTTPS).
# APP_PASSWORD=

# Optional: enable a SHARED, server-side response cache so several devices/tabs
# can watch the same dashboard without each spending from Toggl's hourly budget.
# Requires TOGGL_API_TOKEN above (the cache is keyed to the server's own token).
#
# When set, the front-end's per-device "Refresh interval" picker is hidden and
# this server-driven cadence is used instead. The cache is lazy: it only
# refreshes when someone is actually viewing the page, so an idle dashboard
# makes zero requests. Concurrent loads collapse onto a single upstream fetch.
#
# Value is the refresh interval in SECONDS. Toggl's Free plan allows 30
# requests/hour, so keep it >= 120 (one request per 120s == 30/hr). 180 (the
# default when set to "true") leaves headroom for the one-off connect calls.
# TOGGL_CACHE_INTERVAL=180
