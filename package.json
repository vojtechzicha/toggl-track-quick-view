{
  "name": "toggl-track-quick-view",
  "version": "0.1.0",
  "private": true,
  "description": "A single-screen quick view for tracking a work day (configurable weekly target) on one or more Toggl Track projects.",
  "scripts": {
    "dev": "WAS_RUNNING=$(docker compose ps -q mongo 2>/dev/null); docker compose up -d mongo && trap '[ -z \"$WAS_RUNNING\" ] && docker compose down' EXIT && next dev",
    "devsafe": "rm -rf .next && next dev",
    "build": "next build",
    "vercel-build": "node scripts/check-env.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "db": "docker compose up -d mongo",
    "db:stop": "docker compose down",
    "env:pull": "op inject -i .env.tpl -o .env -f",
    "env:pull:prod": "op inject -i .env.prod.tpl -o .env.prod -f",
    "env:check": "node scripts/check-env.mjs",
    "check:money": "node scripts/check-money.ts",
    "check:report": "node scripts/check-report.ts",
    "check:acceptance": "node scripts/check-acceptance.ts",
    "check:codes": "node scripts/check-codes.ts",
    "check:windows": "node scripts/check-windows.ts",
    "check:export": "node scripts/check-export-scope.ts",
    "check": "npm run check:money && npm run check:report && npm run check:acceptance && npm run check:codes && npm run check:windows && npm run check:export && npm run check:fonts",
    "check:fonts": "node scripts/check-fonts.ts"
  },
  "dependencies": {
    "mongodb": "^7.4.0",
    "next": "^15.1.0",
    "pdfmake": "^0.2.23",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pdfmake": "^0.2.13",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.12",
    "pnpm": ">=10"
  }
}
