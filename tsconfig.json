{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    // The scripts/ checks run straight through node's TypeScript support, which
    // resolves the literal specifier and so needs the .ts extension written out.
    "allowImportingTsExtensions": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    // "@pdf-template-pack" is the optional template pack (lib/export/pdf/pack.ts):
    // the first candidate that exists wins, so a clone without one still type
    // checks. next.config.js resolves the same pair for the bundler.
    "paths": {
      "@/*": ["./*"],
      "@pdf-template-pack": ["./pdf-templates/index.ts", "./lib/export/pdf/emptyPack.ts"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
