{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    // scripts/ checks run under Node's own TypeScript support, which needs the
    // .ts extension in import specifiers.
    "allowImportingTsExtensions": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    // Optional template pack (lib/export/pdf/pack.ts): the first path that
    // exists wins, so a clone without one still type-checks. Keep in step with
    // next.config.js and scripts/resolve-hooks.mjs.
    "paths": {
      "@/*": ["./*"],
      "@pdf-template-pack": ["./pdf-templates/index.ts", "./lib/export/pdf/emptyPack.ts"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
